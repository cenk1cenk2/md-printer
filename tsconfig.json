{
  "extends": "./packages/md-printer/tsconfig.json",
  // the whole workspace, so the templates are type-checked and linted with the CLI
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["packages/md-printer/src/**/*", "packages/md-printer/test/**/*", "packages/md-printer/vitest.config.ts", "templates/*/src/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
