{
  "name": "@cenk1cenk2/md-printer",
  "version": "2.20.5",
  "description": "Render markdown or yaml through Svelte templates into PDF or HTML with Puppeteer.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://gitlab.kilic.dev/utils/md-printer.git",
    "directory": "packages/md-printer"
  },
  "author": "Cenk Kilic",
  "license": "MIT",
  "bin": {
    "md-printer": "bin/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "./bin/dev.js",
    "start": "./bin/run.js",
    "build": "tsdown",
    "dev:start": "tsdown --watch src/",
    "manifest": "oclif manifest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "oclif": {
    "bin": "md-printer",
    "dirname": "md-printer",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.mjs"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@cenk1cenk2/oclif-common"
    ],
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "markdown",
    "pdf",
    "svelte",
    "tailwind",
    "puppeteer",
    "invoice",
    "cli",
    "oclif",
    "cenk1cenk2"
  ],
  "dependencies": {
    "@cenk1cenk2/md-printer-template-cv": "^1.1.0",
    "@cenk1cenk2/md-printer-template-default": "workspace:^",
    "@cenk1cenk2/md-printer-template-invoice": "^1.1.0",
    "@cenk1cenk2/md-printer-template-kilic.dev": "workspace:^",
    "@cenk1cenk2/md-printer-template-mail": "workspace:^",
    "@cenk1cenk2/oclif-common": "^8.0.4",
    "@listr2/manager": "^4.3.4",
    "@nestjs/common": "^12.3.2",
    "@oclif/core": "^5.1.11",
    "@oclif/plugin-help": "^7.0.6",
    "@signpdf/placeholder-plain": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/oxide": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "asn1js": "^3.1.0",
    "change-case": "^5.4.4",
    "chokidar": "^6.0.0",
    "enhanced-resolve": "^5.26.1",
    "entities": "^9.0.0",
    "es-toolkit": "^1.53.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.6",
    "highlight.js": "^11.12.0",
    "i18next": "^26.7.1",
    "lightningcss": "^1.33.0",
    "listr2": "^11.4.1",
    "lowlight": "^3.3.0",
    "mime": "^4.1.2",
    "mupdf": "^1.28.1",
    "perfect-debounce": "^2.1.0",
    "pkijs": "^4.0.1",
    "property-information": "^7.2.0",
    "puppeteer-core": "^25.16.0",
    "raw-body": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rolldown": "^1.2.16",
    "rxjs": "^7.8.2",
    "serve-static": "^2.2.1",
    "source-map-support": "^0.5.21",
    "srcset": "^5.0.3",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "which": "^7.0.0",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/serve-static": "^2.2.0",
    "@types/which": "^3.0.4",
    "@types/write-file-atomic": "^4.0.3",
    "execa": "^10.2.1",
    "oclif": "^6.0.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "bugs": {
    "url": "https://gitlab.kilic.dev/utils/md-printer/-/issues"
  },
  "homepage": "https://gitlab.kilic.dev/utils/md-printer"
}
