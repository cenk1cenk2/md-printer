{
  "name": "@cenk1cenk2/md-printer",
  "version": "2.20.4",
  "description": "A markdown printer.",
  "module": "dist/index.mjs",
  "type": "module",
  "repository": "https://gitlab.kilic.dev/utils/md-printer",
  "author": "Cenk Kilic",
  "license": "MIT",
  "bin": {
    "md-printer": "bin/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "./bin/dev.js",
    "start": "./bin/run.js",
    "build": "tsdown",
    "dev:start": "tsdown --watch src/",
    "clean": "rimraf oclif.manifest.json",
    "format": "prettier --write src/ --log-level warn && eslint --fix",
    "lint": "eslint",
    "manifest": "oclif manifest",
    "docs:toc": "oclif readme"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "prepare-commit-msg": "[ -t 1 ] && exec < /dev/tty && git cz --hook || true"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "prettier --log-level warn --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --log-level warn --write"
    ]
  },
  "files": [
    "/config",
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "templates/"
  ],
  "oclif": {
    "bin": "md-printer",
    "dirname": "md-printer",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.mjs"
    },
    "plugins": [
      "@oclif/plugin-help"
    ],
    "hooks": {
      "init": [
        "./dist/hooks/update-notifier.hook"
      ],
      "command_not_found": "./dist/hooks/not-found.hook"
    },
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "oclif",
    "cenk1cenk2"
  ],
  "dependencies": {
    "@cenk1cenk2/oclif-common": "^7.1.0",
    "@listr2/manager": "^4.2.5",
    "@nestjs/common": "^12.0.1",
    "@oclif/core": "^5.0.0",
    "@oclif/plugin-help": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "chokidar": "^5.0.0",
    "fs-extra": "^11.4.0",
    "get-port": "^7.2.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.4.2",
    "listr2": "^11.1.0",
    "md-to-pdf": "^5.2.5",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.28",
    "puppeteer": "^25.10.0",
    "rxjs": "^7.8.2",
    "showdown": "^2.1.0",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cenk1cenk2/cz-cc": "^2.3.2",
    "@cenk1cenk2/eslint-config": "^3.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@types/nunjucks": "^3.2.6",
    "@types/showdown": "^2.0.6",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "globby": "^16.2.4",
    "lint-staged": "^17.4.1",
    "oclif": "^5.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "simple-git-hooks": "^2.14.0",
    "theme-colors": "^0.1.0",
    "tpm": "^1.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@cenk1cenk2/cz-cc"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
