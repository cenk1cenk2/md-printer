{
  "name": "md-printer-workspace",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "templates/*"
    ]
  },
  "scripts": {
    "build": "pnpm --filter @cenk1cenk2/md-printer run build",
    "dev:start": "pnpm --filter @cenk1cenk2/md-printer run dev:start",
    "test": "pnpm --filter @cenk1cenk2/md-printer run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write packages/ templates/ --log-level warn && eslint --fix"
  },
  "devDependencies": {
    "@cenk1cenk2/cz-cc": "^3.0.13",
    "@cenk1cenk2/eslint-config": "^3.4.7",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@cenk1cenk2/cz-cc"
    }
  },
  "packageManager": "pnpm@12.17.0"
}
