amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["prettier"] = (Builtins.prettier) {
        glob = List("*.ts", "*.js", "*.json", "*.svelte")
      }
      ["eslint"] = (Builtins.eslint) {
        glob = List("*.ts", "*.js", "*.svelte")
        depends = List("prettier")
      }
      ["typecheck"] {
        check = "pnpm run typecheck"
        depends = List("eslint")
      }
    }
  }
  ["prepare-commit-msg"] {
    steps {
      ["commitizen"] {
        fix = "git cz --hook"
        interactive = true
      }
    }
  }
}
